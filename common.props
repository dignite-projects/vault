<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Version>0.6.0</Version>
        <!-- Pinned explicitly: without this the SDK derives AssemblyVersion from <Version>,
             moving it on every MINOR/PATCH — see CONTRIBUTING.md "Where the version lives". -->
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <!--
          CS1591: missing XML docs (we document public APIs with rich /// comments where it matters
                  but don't require it everywhere).
          MAAI001: Microsoft.Agents.AI APIs still carry experimental annotations on some
                   stable-in-practice surfaces we use (ChatClientAgent / OpenTelemetry).
                   Keep this explicit until Microsoft removes the analyzer warning.
        -->
        <NoWarn>$(NoWarn);CS1591;MAAI001</NoWarn>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <!-- One version for every module, with one exception: a module whose packages must stay pre-release while the
         line moves on sets VaultPrereleaseModule in its Directory.Build.props (vault.index, until
         Microsoft.Extensions.DataIngestion is stable: a stable package cannot depend on a pre-release one). A
         stable <Version> above then packs as <Version>-preview for that module; a pre-release one is used as it
         is. The release workflow reads the first <Version> in this file, which stays the line's version. -->
    <PropertyGroup Condition="'$(VaultPrereleaseModule)' == 'true' And !$(Version.Contains('-'))">
        <Version>$(Version)-preview</Version>
    </PropertyGroup>

    <PropertyGroup Label="NuGet package metadata">
        <Authors>Dignite</Authors>
        <Company>Dignite</Company>
        <!-- A module sets its own Product / PackageTags in its Directory.Build.props (vault.parse does);
             these are the Extract defaults. -->
        <Product Condition="'$(Product)' == ''">Dignite Vault Extract</Product>
        <Copyright>© Dignite</Copyright>
        <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/dignite-projects/vault</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dignite-projects/vault</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags Condition="'$(PackageTags)' == ''">abp;extract;document-processing;ocr;markdown;mcp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <!-- Package the repository root README.md and .github/icon.png. For IsPackable=false projects
         (host / tests), these are only non-compiling None items and have no side effects. -->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory).github\icon.png" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!-- Source Link + embedded symbols, so consumers can step into the exact source that built a
         package. Deterministic is already SDK-default true. ContinuousIntegrationBuild is not, and
         stays gated on GITHUB_ACTIONS: only CI builds should bake in path-independent PDBs, since
         forcing it on locally would replace real local paths and break local step-through debugging.

         PDBs are embedded in the DLL (DebugType=embedded) rather than shipped as a separate .snupkg:
         Fody strips the PdbChecksum debug-directory entry when it weaves the assembly, which makes
         NuGet.org's symbol validation reject the .snupkg ("checksum does not match for the dll(s)
         and corresponding pdb(s)"). An embedded portable PDB carries the same Source Link data, so
         step-into still works, and there is no separate symbol package for NuGet.org to validate. -->
    <PropertyGroup Label="Source Link / embedded symbols">
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <DebugType>embedded</DebugType>
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup Label="Source Link / symbol packages">
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ConfigureAwait.Fody" PrivateAssets="All"/>
        <PackageReference Include="Fody">
            <PrivateAssets>All</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
        <PropertyGroup>
            <NoWarn>$(NoWarn);0436</NoWarn>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <None Remove="**\*.abppkg"/>
        <None Remove="**\*.abppkg.analyze.json"/>
        <Content Remove="$(UserProfile)\.nuget\packages\*\*\contentFiles\any\*\*.abppkg*"/>
    </ItemGroup>

</Project>
