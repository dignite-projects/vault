<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    </PropertyGroup>

    <ItemGroup Label="Build tools">
        <PackageVersion Include="ConfigureAwait.Fody" Version="3.4.1" />
        <PackageVersion Include="Fody" Version="6.9.3" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    </ItemGroup>

    <ItemGroup Label="ABP Framework">
        <PackageVersion Include="Volo.Abp.Core" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Authorization" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Autofac" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Features" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Guids" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Validation" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.VirtualFileSystem" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.EventBus.Abstractions" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Gdpr.Abstractions" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Http.Client" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Mapperly" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Ddd.Domain.Shared" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Ddd.Domain" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Ddd.Application.Contracts" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Ddd.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.BackgroundJobs" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.BlobStoring" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.BlobStoring.FileSystem" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Auditing" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.AspNetCore.Mvc" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.AspNetCore.Serilog" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Swashbuckle" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Account.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Account.HttpApi" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Account.Web.OpenIddict" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Identity.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Identity.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.Identity.HttpApi" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.PermissionManagement.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.PermissionManagement.HttpApi" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.PermissionManagement.Web" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.FeatureManagement.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.FeatureManagement.HttpApi" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.SettingManagement.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.SettingManagement.HttpApi" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.TenantManagement.Application" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.TenantManagement.EntityFrameworkCore" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.TenantManagement.HttpApi" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.TestBase" Version="11.0.0-rc.2" />
        <PackageVersion Include="Volo.Abp.AspNetCore.TestBase" Version="11.0.0-rc.2" />
    </ItemGroup>

    <!-- Dignite.Abp.FlexFields: the runtime-defined-field constraint kernel field architecture v3 is
         built on (#558). Stable since abp-modules 10.7.0, which lifted the NU5104 gate on a stable
         nuget.org release. Only the four packages actually consumed are pinned:
         .Web (SSR TagHelpers), .FileExplorer, .CKEditor.Web and .MongoDB are not used here.
         Keep this version equal to angular/package.json's @dignite/ng.flex-fields(-ckeditor) pins - the
         two exist to keep the same wire shape on both ends, and nothing but this comment enforces it.
         They drifted 6 rc's apart (rc.5 here against rc.11 there) with no build ever catching it before
         this note was added. -->
    <ItemGroup Label="FlexFields">
        <PackageVersion Include="Dignite.Abp.FlexFields.Abstractions" Version="10.7.6" />
        <PackageVersion Include="Dignite.Abp.FlexFields.Domain" Version="10.7.6" />
        <PackageVersion Include="Dignite.Abp.FlexFields.EntityFrameworkCore" Version="10.7.6" />
        <!-- Serves FieldDataType.LongText in v3: CKEditorFieldType.IndexValueType is null, so
             "never indexed, never queryable" stays a structural guarantee, and ContentFormat=Markdown
             persists the value as a plain GFM string (#559 resolution 1). -->
        <PackageVersion Include="Dignite.Abp.FlexFields.CKEditor" Version="10.7.6" />
    </ItemGroup>

    <ItemGroup Label="LeptonX">
        <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="6.0.0-rc.2" />
    </ItemGroup>

    <ItemGroup Label="ABP Studio">
        <PackageVersion Include="Volo.Abp.Studio.Client.AspNetCore" Version="3.1.6" />
    </ItemGroup>

    <ItemGroup Label="AI">
        <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
        <!-- Vault Index ingestion. Pre-release until Microsoft ships a stable Microsoft.Extensions.DataIngestion. -->
        <PackageVersion Include="Microsoft.Extensions.DataIngestion" Version="11.0.0-preview.1.26560.3" />
        <PackageVersion Include="Microsoft.Extensions.DataIngestion.Markdig" Version="11.0.0-preview.1.26560.3" />
        <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup Label="MCP">
        <!-- At least the version Dignite.Abp.AspNetCore.Mcp is built against: every module on one MCP
             server shares this SDK, so it moves with abp-modules rather than on its own. -->
        <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
        <!-- The shared MCP server (transport, /mcp, permission filtering, error envelope, namespaces) that
             Dignite.Vault.Extract.Mcp contributes its tools to. Released with abp-modules in lockstep, so
             it moves with the Dignite.Abp.FlexFields.* pins above. -->
        <PackageVersion Include="Dignite.Abp.AspNetCore.Mcp" Version="10.7.6" />
    </ItemGroup>

    <ItemGroup Label="Notifications">
        <!-- Dignite.NotificationCenter (#680): operator in-app notifications. Published to nuget.org with
             abp-modules (no GitHub Packages source needed). The NuGet packages and the npm package
             @dignite/ng.notification-center always share one version - keep this equal to
             angular/package.json's pin. -->
        <PackageVersion Include="Dignite.Abp.Notifications.Abstractions" Version="10.7.6" />
        <PackageVersion Include="Dignite.Abp.Notifications.SignalR" Version="10.7.6" />
        <PackageVersion Include="Dignite.NotificationCenter.Application" Version="10.7.6" />
        <PackageVersion Include="Dignite.NotificationCenter.HttpApi" Version="10.7.6" />
        <PackageVersion Include="Dignite.NotificationCenter.EntityFrameworkCore" Version="10.7.6" />
    </ItemGroup>

    <ItemGroup Label="OpenTelemetry">
        <!-- The host wires up the export pipeline so Microsoft.Extensions.AI's gen_ai.* spans and the
             project-owned Dignite.Vault.Extract.* Meters reach OTLP. -->
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    </ItemGroup>

    <ItemGroup Label="Infrastructure">
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0" />
        <!-- EF Core 11's Tools package no longer brings Design; dotnet ef needs it in the startup project. -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" />
        <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <!-- The host's model clients (chat, embedding, rerank) run on its standard resilience pipeline. -->
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
        <PackageVersion Include="ElBruno.MarkItDotNet" Version="0.6.0" />
        <PackageVersion Include="ElBruno.MarkItDotNet.Excel" Version="0.6.0" />
        <!-- Charset detection for legacy-encoded CSV/TSV/TXT uploads (#493). Tri-licensed MPL-1.1 /
             GPL-2.0-or-later / LGPL-2.1-or-later; taken here under the LGPL arm, which "or later" makes
             compatible with this repository's LGPL-3.0-only license. -->
        <PackageVersion Include="UTF.Unknown" Version="2.7.0" />
        <!-- PdfPig: digital-PDF text layer + embedded raster image extraction for the PdfExtractor (#301).
             Pinned to the exact version ElBruno.MarkItDotNet 0.6.0 pulls transitively, so the host process
             resolves a single PdfPig (no upgrade/downgrade conflict between the two providers). -->
        <PackageVersion Include="PdfPig" Version="0.1.14" />
        <!-- OpenXML SDK: PPTX (#307) / DOCX (#308) structural extraction for the OpenXmlExtractor stack.
             Pinned to the exact version ElBruno.MarkItDotNet 0.6.0 pulls transitively (3.3.0), so the host
             process resolves a single DocumentFormat.OpenXml (no conflict between the two providers). -->
        <PackageVersion Include="DocumentFormat.OpenXml" Version="3.3.0" />
        <PackageVersion Include="PDFtoImage" Version="5.2.1" />
        <!-- Must exactly match the SkiaSharp main package version transitively used by PDFtoImage 5.2.1 (3.119.2).
             Both entries below: SkiaSharp is referenced directly by Ocr.VisionLlm (image downscaling, #692). -->
        <PackageVersion Include="SkiaSharp" Version="3.119.2" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
        <!-- Markdig.Signed, not Markdig: Microsoft.Extensions.DataIngestion.Markdig depends on the signed package, and the two
             ship the same Markdig.dll, so a host that carries both ends up with whichever copy wins. Same version, same code. -->
        <PackageVersion Include="Markdig.Signed" Version="1.3.2" />
        <!-- HtmlAgilityPack: Vault Index reads the HTML tables in Markdown (Azure Document Intelligence writes every table as HTML). -->
        <PackageVersion Include="HtmlAgilityPack" Version="1.12.3" />
        <!-- ElBruno.MarkItDotNet.Excel 0.6.0 requires ClosedXML >= 0.105.0. Keep the
             application export writer and XLSX Markdown converter on one resolved version. -->
        <PackageVersion Include="ClosedXML" Version="0.105.0" />
        <PackageVersion Include="IdentityModel" Version="7.0.0" />
        <PackageVersion Include="KubernetesClient" Version="19.0.2" />
        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
        <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
        <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup Label="Test">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    </ItemGroup>

</Project>
