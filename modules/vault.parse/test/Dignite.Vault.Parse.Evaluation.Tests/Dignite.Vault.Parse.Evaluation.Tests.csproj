<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.test.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse.Evaluation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The parse-quality evaluation: a corpus with ground truth (Corpus/, generated by etc/eval/parse_corpus.py), scored
         by a Microsoft.Extensions.AI.Evaluation evaluator and stored with its disk-based reporting. The documents that
         need OCR call a vision model and run only when VAULT_PARSE_EVAL_VISION_* is set. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Volo.Abp.TestBase" />
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="HtmlAgilityPack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse\Dignite.Vault.Parse.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse.Pdf\Dignite.Vault.Parse.Pdf.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse.OpenXml\Dignite.Vault.Parse.OpenXml.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse.ElBrunoMarkItDown\Dignite.Vault.Parse.ElBrunoMarkItDown.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse.Ocr.VisionLlm\Dignite.Vault.Parse.Ocr.VisionLlm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Corpus\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Reports\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
