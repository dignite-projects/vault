<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.test.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Two kinds of tests for the ParseRoutingClient router. Pure unit tests NSubstitute the engines and
         construct the router with new(...) - no ABP TestBase, no DB, no real engine module - to reach the branches
         the integration tests cannot: the no-capable-engine throw (no catch-all is ever installed there), the
         same-priority tie-break and exhaustive image-extension dispatch. The AbpIntegratedTest-based
         ParseRoutingClientIntegration / ParseRoutingClientDispatch / TextEncodingNormalization tests wire the real
         ElBruno catch-all; they lived in Extract's Application.Tests until the Parse split (#716). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <!-- For ExposedServiceExplorer in the DI-registration regression test. -->
    <PackageReference Include="Volo.Abp.Core" />
    <!-- AbpIntegratedTest and the Autofac container for the integration-style tests. -->
    <PackageReference Include="Volo.Abp.TestBase" />
    <PackageReference Include="Volo.Abp.Autofac" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ParseTestKit.cs" Link="ParseTestKit.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse\Dignite.Vault.Parse.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse.ElBrunoMarkItDown\Dignite.Vault.Parse.ElBrunoMarkItDown.csproj" />
  </ItemGroup>

</Project>
