<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.test.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Two kinds of tests for the DefaultTextExtractor orchestrator. Pure unit tests NSubstitute the
         IOcrProvider and the IMarkdownTextProvider side-contract and construct the extractor with new(...) -
         no ABP TestBase, no DB, no real provider module - to reach the branches the integration tests cannot:
         the no-capable-provider throw (no catch-all is ever installed there), the same-priority tie-break, the
         half-filled native-payload drop, and exhaustive image-extension dispatch. The AbpIntegratedTest-based
         DefaultTextExtractor / MarkdownProviderDispatch / TextEncodingNormalization tests wire the real ElBruno
         catch-all; they lived in Extract's Application.Tests until the Parse split (#716). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <!-- For ExposedServiceExplorer in the DI-registration regression test. -->
    <PackageReference Include="Volo.Abp.Core" />
    <!-- AbpIntegratedTest and the Autofac container for the integration-style tests. -->
    <PackageReference Include="Volo.Abp.TestBase" />
    <PackageReference Include="Volo.Abp.Autofac" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse\Dignite.Vault.Parse.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Vault.Parse.ElBrunoMarkItDown\Dignite.Vault.Parse.ElBrunoMarkItDown.csproj" />
  </ItemGroup>

</Project>
