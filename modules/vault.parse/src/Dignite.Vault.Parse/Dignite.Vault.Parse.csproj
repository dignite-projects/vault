<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse</RootNamespace>
    <Description>Text-extraction orchestration for Dignite Vault Extract: the default ITextExtractor implementation that dispatches by file extension between OCR and Markdown providers (with OCR fallback for PDFs without a text layer), plus the IMarkdownTextProvider contract.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
    <ProjectReference Include="..\Dignite.Vault.Parse.Abstractions\Dignite.Vault.Parse.Abstractions.csproj" />
    <ProjectReference Include="..\Dignite.Vault.Parse.Ocr\Dignite.Vault.Parse.Ocr.csproj" />
  </ItemGroup>

</Project>
