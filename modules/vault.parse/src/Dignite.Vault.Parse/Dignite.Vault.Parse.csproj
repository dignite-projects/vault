<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse</RootNamespace>
    <Description>The Dignite Vault Parse router (a DocumentExtractionClient that sends each file to the engine that reads it, with OCR for PDFs without a text layer), the Markdown reader for engines that answer in Markdown, and the helpers the engines share.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
    <PackageReference Include="Markdig.Signed" />
    <PackageReference Include="HtmlAgilityPack" />
    <ProjectReference Include="..\Dignite.Vault.Parse.Abstractions\Dignite.Vault.Parse.Abstractions.csproj" />
  </ItemGroup>

</Project>
