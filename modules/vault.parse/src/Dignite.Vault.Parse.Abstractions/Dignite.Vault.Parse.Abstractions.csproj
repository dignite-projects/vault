<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse</RootNamespace>
    <Description>Contracts of Dignite Vault Parse, on Microsoft.Extensions.DocumentExtraction: the engine base classes, the options and metadata conventions, the Markdown rendering of a document and the image-OCR markup. A consumer references it without pulling in the router or any engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
    <PackageReference Include="Microsoft.Extensions.Documents.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction.Abstractions" />
  </ItemGroup>

</Project>
