<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse.Pdf</RootNamespace>
    <Description>PdfPig engine for Dignite Vault Parse: reads the digital text layer of a PDF (reading order, headings, tables, running headers and footers) and transcribes embedded images through the host OCR engine, one section per page. A DocumentExtractionClient that returns a Microsoft.Extensions.Documents document.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
    <!-- Pure-managed PDF parsing: digital text layer (words + bbox + reading order) and embedded
         image XObjects (bytes + bbox). No native dependency, unlike the VisionLlm PDFium rasterizer.
         Version pinned to match the PdfPig that ElBruno.MarkItDotNet pulls transitively, so the host
         process resolves a single PdfPig. -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <!-- References Parse core (the router, the Markdown reader, shared helpers), which brings Abstractions
         (ParseExtractionClient, ParseOcrClient). No keyed Vision IChatClient is injected here: image
         transcription goes through the host-selected OCR engine only. -->
    <ProjectReference Include="..\Dignite.Vault.Parse\Dignite.Vault.Parse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dignite.Vault.Parse.Pdf.Tests" />
  </ItemGroup>

</Project>
