<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Parse.OpenXml</RootNamespace>
    <Description>OpenXML engines for Dignite Vault Parse: PptxExtractor (slide text, alt text, speaker notes, charts and tables, one section per slide) and DocxExtractor (headings, tables, lists, inline formatting, hyperlinks, text boxes, notes), each transcribing embedded images through the host OCR engine. DocumentExtractionClients that return a Microsoft.Extensions.Documents document.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
    <!-- OpenXML SDK: PresentationDocument parsing (slide text, embedded ImageParts, ChartPart backing
         data, native alt-text). Version pinned to match the DocumentFormat.OpenXml that
         ElBruno.MarkItDotNet pulls transitively (3.3.0), so the host process resolves a single OpenXml
         (no upgrade/downgrade conflict between the two engines — same discipline as PdfPig). -->
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <!-- References Parse core (the router, the Markdown reader, shared helpers), which brings Abstractions
         (ParseExtractionClient, ParseOcrClient). No keyed Vision IChatClient is injected here: image
         transcription goes through the host-selected OCR engine only. -->
    <ProjectReference Include="..\Dignite.Vault.Parse\Dignite.Vault.Parse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dignite.Vault.Parse.OpenXml.Tests" />
  </ItemGroup>

</Project>
