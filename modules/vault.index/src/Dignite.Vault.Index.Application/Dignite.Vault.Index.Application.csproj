<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Index</RootNamespace>
    <Description>Application layer of Dignite Vault Index: event handlers and ingestion jobs fed by Vault Extract, and the retrieval pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" />
    <PackageReference Include="Volo.Abp.BackgroundJobs" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Ingestion builds on DataIngestion's reader, chunkers and enrichers. Its IngestionPipeline is not used: it reads
         files only, and the Markdown comes from Extract in memory (storage PoC, step 2). -->
    <PackageReference Include="Microsoft.Extensions.DataIngestion" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Markdig" />
    <!-- Pins the reader's Markdig to the repository's version (DataIngestion.Markdig asks for >= 0.43). -->
    <PackageReference Include="Markdig.Signed" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <ProjectReference Include="..\Dignite.Vault.Index.Application.Contracts\Dignite.Vault.Index.Application.Contracts.csproj" />
    <ProjectReference Include="..\Dignite.Vault.Index.Domain\Dignite.Vault.Index.Domain.csproj" />
    <ProjectReference Include="..\Dignite.Vault.Index.Abstractions\Dignite.Vault.Index.Abstractions.csproj" />
    <!-- Extract's egress contract only: the integration service (ingestion) and the read scope (retrieval).
         etc/scripts/check-module-references.mjs fails the build on any other Extract project. -->
    <ProjectReference Include="..\..\..\vault.extract\src\Dignite.Vault.Extract.Application.Contracts\Dignite.Vault.Extract.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
