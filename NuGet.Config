<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Every dependency resolves from nuget.org, except the abp-modules pre-releases mapped to `github` below:
         Dignite Blob Management has no stable release yet, so its packages (and the blob-storing packages they
         depend on at the same lockstep version) come from abp-modules' GitHub Packages feed. Drop the source and
         the mapping when Blob Management reaches nuget.org.

         Reading GitHub Packages requires auth even for public packages: set the environment variable
         GITHUB_PACKAGES_TOKEN to a PAT with the read:packages scope (CI passes secrets.PACKAGES_READ_TOKEN). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/dignite-projects/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="dignite-projects" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Dignite.Abp.BlobManagement*" />
      <package pattern="Dignite.Abp.BlobStoring*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
